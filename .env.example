# ── JOJO International — Server environment (Vercel Functions) ────────────────
# Copy this file to `.env` for local development, and set the same variables in
# the Vercel project dashboard (Settings → Environment Variables).
# NEVER commit real values. `.env` is gitignored.

# Recipient for contact-form submissions delivered via the local outbox sink.
# When FORM_DELIVERY_URL is set, this is used as the "to" field in the payload.
CONTACT_RECIPIENT_EMAIL=contact@jojo-international.com

# Maximum accepted resume size in MB. Must stay below Vercel's 4.5 MB function
# body limit. Client-side config lives in src/data/contact.ts and must match.
RESUME_MAX_SIZE_MB=3

# Optional delivery destination. When set, contact/career submissions are POSTed
# here as JSON (Content-Type: application/json) with an optional auth token.
# Use this to wire an email API (e.g. Resend/Mailgun), CRM webhook, or any
# provider-agnostic endpoint. When unset, submissions are written to the local
# outbox sink at server/.data/outbox.jsonl for development only.
# FORM_DELIVERY_URL=
# FORM_DELIVERY_TOKEN=

# Set by Vercel automatically. Leave unset locally.
# NODE_ENV=production
