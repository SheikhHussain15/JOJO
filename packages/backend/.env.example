# ── JOJO International ── Backend environment ──────────────────────────────
# Copy this file to `.env` for local development. NEVER commit real values.
# `.env` is gitignored.

# Address to bind. 127.0.0.1 keeps it local; use 0.0.0.0 to expose it.
HOST=127.0.0.1
PORT=4000

# Recipient for contact-form submissions delivered via the local outbox sink.
# When FORM_DELIVERY_URL is set, this is used as the "to" field in the payload.
CONTACT_RECIPIENT_EMAIL=contact@jojo-international.com

# Maximum accepted resume size in MB. Must match the client-side config in
# packages/frontend/src/data/contact.ts.
RESUME_MAX_SIZE_MB=3

# Optional delivery destination. When set, contact/career submissions are POSTed
# here as JSON (Content-Type: application/json) with an optional auth token.
# Use this to wire an email API (e.g. Resend/Mailgun), CRM webhook, or any
# provider-agnostic endpoint. When unset, submissions are written to the local
# outbox sink at packages/backend/.data/outbox.jsonl for development only.
# FORM_DELIVERY_URL=
# FORM_DELIVERY_TOKEN=

# Allowed CORS origin(s) for the frontend. Comma-separated. When unset, any
# origin is allowed (development default).
# CORS_ORIGINS=http://localhost:3000
