# Frontend environment — copy to `.env.local` for local development.
# NEVER commit real values. `.env.local` is gitignored.

# Optional: absolute base URL for the backend API. When unset (default) the
# frontend calls same-origin /api/*, which next.config.ts proxies to
# http://127.0.0.1:4000 in local dev (see BACKEND_ORIGIN). Set this only when
# the backend is deployed to a different origin.
# NEXT_PUBLIC_API_URL=https://api.example.com
